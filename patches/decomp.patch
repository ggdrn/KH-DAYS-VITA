diff --git a/include/nitro/kh_hw.h b/include/nitro/kh_hw.h
new file mode 100644
index 000000000..ce767ded3
--- /dev/null
+++ b/include/nitro/kh_hw.h
@@ -0,0 +1,66 @@
+/* KH_HW(addr): a fixed hardware address of the DS, as the code uses it.
+ *
+ * On the DS this is the address itself, so every source compiles to the same bytes as before.
+ * The PS Vita port (khdays-vita, PLATFORM_VITA) maps each address to the host memory that
+ * stands in for that register block, VRAM view or shared-area word (its kh_hw_map.h).
+ * tools/rewrite_decomp.py in the port wraps the addresses. */
+#ifndef NITRO_KH_HW_H
+#define NITRO_KH_HW_H
+
+#ifdef PLATFORM_VITA
+#include "kh_hw_map.h"
+#else
+#define KH_HW(addr) (addr)
+#endif
+
+/* KH_DS_PTR(addr): a pointer the game packed into 24 bits and unpacked as a DS address.
+ * Archive handles keep ((ptr + 0x8000) & 0xfffffc) << 7 and add 0x01ff8000 back, which only
+ * works while every pointer lies in the DS's 16 MiB from 0x01ff8000. On the Vita the port finds
+ * the host pointer those 24 bits belong to (the main or ITCM arena). The DS address itself on
+ * the DS. */
+#ifdef PLATFORM_VITA
+unsigned long kh_ds_unpack_ptr(unsigned long ds_addr);
+#define KH_DS_PTR(addr) kh_ds_unpack_ptr(addr)
+#else
+#define KH_DS_PTR(addr) (addr)
+#endif
+
+/* KH_IS_PACKED(v): whether a file argument is a packed archive handle (see KH_DS_PTR) rather
+ * than a file name. The DS tells them apart by bit 31 -- its pointers are 0x02xxxxxx -- but on
+ * the Vita every pointer has bit 31 set. There the port checks that v unpacks to a pack header
+ * in an arena whose archive (+8) is the ROM archive. Bit 31 itself on the DS. */
+#ifdef PLATFORM_VITA
+int kh_is_packed_handle(unsigned long v);
+#define KH_IS_PACKED(v) kh_is_packed_handle((unsigned long)(v))
+#else
+#define KH_IS_PACKED(v) ((u32)(v) & 0x80000000)
+#endif
+
+/* KH_GX_CMD(reg, v): a store to a geometry command register (or the GX FIFO port). On the
+ * Vita a store would only land in memory, so it goes to the port's geometry engine; the store
+ * itself on the DS. tools/rewrite_decomp.py (gxcmd) writes these. */
+#ifdef PLATFORM_VITA
+void kh_gx_cmd(volatile void *reg, unsigned long value);
+#define KH_GX_CMD(reg, v) kh_gx_cmd((volatile void *)&(reg), (unsigned long)(v))
+#else
+#define KH_GX_CMD(reg, v) ((reg) = (v))
+#endif
+
+/* KH_TRACE("..."): a boot milestone in the port's log (printf format). Nothing on the DS. */
+#ifdef PLATFORM_VITA
+void kh_trace(const char *fmt, ...);
+#define KH_TRACE(...) kh_trace(__VA_ARGS__)
+#else
+#define KH_TRACE(...) ((void)0)
+#endif
+
+/* KH_ALIGN64 after a struct member declared as a plain `long long`: mwcc aligns 64-bit
+ * integers to 4 bytes, GCC for ARM to 8, which would pad the struct differently. (u64 and
+ * s64 carry the DS alignment in their typedefs, nitro/types.h.) Nothing on the DS. */
+#ifdef PLATFORM_VITA
+#define KH_ALIGN64 __attribute__((packed, aligned(4)))
+#else
+#define KH_ALIGN64
+#endif
+
+#endif
